# MCD Infinity API Configuration
# Copy this file to .env and customize values for your environment:
# cp .env.example .env

# Port on which the API server listens (default: 3000)
PORT=3000

# Temenos Transact Core Banking Customer Creation API URL
# Ensure the host server has network route and firewall access to this IP & Port
TRANSACT_API_URL=http://192.168.1.157:8085/irf-provider-container/api/v5.1.0/party/customers

# Azure Application Gateway Sticky Session Cookie (ApplicationGatewayAffinity)
TRANSACT_COOKIE=ApplicationGatewayAffinity=169ff9c6fbc8876c0b34e7b7497e23fe;ApplicationGatewayAffinityCORS=169ff9c6fbc8876c0b34e7b7497e23fe

# Temenos Transact OAuth2 JWT Bearer Token
# Leave empty to use built-in token, or override with freshly issued JWT
TRANSACT_BEARER_TOKEN=

# Mock Mode (true / false)
# When set to true, simulates Transact customer creation offline without calling remote server
MOCK_TRANSACT=false
